# Copy to .env (or export in your shell). Every value has a working default;
# the local/hash/mock combination runs fully offline.

# --- engine ---------------------------------------------------------------
NEXUS_LLM_PROVIDER=mock             # mock | openai
NEXUS_EMBEDDING_PROVIDER=hash       # hash | openai
NEXUS_DATABASE_URL=sqlite:///data/nexus.db

# OpenAI-compatible endpoint (DeepSeek/Qwen/BGE-M3 all work here)
NEXUS_LLM_BASE_URL=https://api.openai.com/v1
NEXUS_LLM_API_KEY=
NEXUS_LLM_MODEL=gpt-4o-mini
NEXUS_EMBEDDING_MODEL=text-embedding-3-small
NEXUS_EMBEDDING_DIM=384

# --- storage backends ---------------------------------------------
NEXUS_VECTOR_BACKEND=local          # local | milvus
NEXUS_MILVUS_URI=http://127.0.0.1:19530
NEXUS_MILVUS_COLLECTION=nexusagent_chunks

NEXUS_GRAPH_BACKEND=local           # local | neo4j
NEXUS_NEO4J_URI=bolt://127.0.0.1:7687
NEXUS_NEO4J_USER=neo4j
NEXUS_NEO4J_PASSWORD=nexusagent

NEXUS_OCR_BACKEND=none              # none | mineru
NEXUS_MINERU_BASE_URL=http://127.0.0.1:8888

# --- multi-instance -------------------------------------------------------
# Empty = in-process queues (one API process). Point this at Redis when you run
# more than one uvicorn worker, so a stream can be served by any instance.
NEXUS_REDIS_URL=
# PostgreSQL works through the same SQLAlchemy layer as SQLite:
# NEXUS_DATABASE_URL=postgresql+psycopg://nexus:nexus@127.0.0.1:5432/nexus

# --- retrieval knobs ------------------------------------------------------
NEXUS_CHUNK_SIZE=420
NEXUS_CHUNK_OVERLAP=80
NEXUS_RRF_K=60
NEXUS_RERANK_TOP_K=5
NEXUS_LOW_CONFIDENCE_THRESHOLD=0.35
